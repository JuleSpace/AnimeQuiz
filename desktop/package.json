{
  "name": "poke-prairie",
  "productName": "Poké Prairie",
  "version": "1.0.0",
  "description": "Poké Prairie en bandeau sur le bureau, synchronisé avec Bully's Lair.",
  "author": "Jules Broto",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac zip",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "dev.bullys-lair.prairie",
    "productName": "Poké Prairie",
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Poké Prairie",
      "artifactName": "Poke-Prairie-Setup.exe"
    },
    "portable": {
      "artifactName": "Poke-Prairie-portable.exe"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game"
    }
  }
}
