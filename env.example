# Configuration pour Railway
PORT=5000
MONGODB_URI=mongodb://localhost:27017/animequiz

# URL du client (pour les CORS)
CLIENT_URL=http://localhost:3000

# Configuration de production Railway
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/animequiz
# CLIENT_URL=https://bullys-lair.dev

# Connexion avec Discord (comptes joueurs, sauvegardes en ligne, classements)
# Crée une application sur https://discord.com/developers/applications → OAuth2,
# ajoute la redirection https://<ton-site>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=https://bullys-lair.dev/auth/discord/callback
# Clé de signature des sessions (une longue chaîne aléatoire)
SESSION_SECRET=
